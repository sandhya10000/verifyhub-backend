<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Credit Analysis Report — <%- data.client_name || 'Client' %></title>
<style>
:root{
 --grad:linear-gradient(135deg,#4A00E0 0%,#8E2DE2 100%);
 --crit:#dc3545;--high:#fd7e14;--med:#ffc107;--low:#28a745;
 --bg:#f4f6f9;--card:#fff;--ink:#2d3436;--muted:#6b7280;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);
 font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;line-height:1.55}
.container{max-width:1200px;margin:0 auto;padding:0 16px 60px}
.card{background:var(--card);border-radius:12px;box-shadow:0 4px 6px rgba(0,0,0,.1);
 padding:26px;margin:22px 0}
h1,h2,h3,h4{margin:0 0 12px}
.section-title{font-size:1.45rem;border-left:6px solid #8E2DE2;padding-left:12px;margin:34px 0 6px}
.section-no{color:#8E2DE2;font-weight:700}
.lead{color:var(--muted);margin:0 0 18px;padding-left:18px}
table{width:100%;border-collapse:collapse;margin:14px 0;font-size:.92rem}
th{background:var(--grad);color:#fff;padding:11px 10px;text-align:left;font-weight:600}
td{padding:10px;border-bottom:1px solid #eef0f4}
tbody tr:hover{background:#f7f4ff}
.badge{display:inline-block;padding:3px 10px;border-radius:20px;color:#fff;font-size:.72rem;
 font-weight:700;letter-spacing:.3px}
.b-CRITICAL{background:var(--crit)}.b-HIGH{background:var(--high)}
.b-MEDIUM{background:var(--med);color:#5a4b00}.b-LOW{background:var(--low)}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:22px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.gridkv{display:grid;grid-template-columns:repeat(2,1fr);gap:8px 26px;font-size:.9rem}
.kv{display:flex;justify-content:space-between;border-bottom:1px dotted #e3e6ee;padding:5px 0}
.kv b{font-weight:600}
.chartimg{width:100%;height:auto;border-radius:8px;display:block}
.statbox{background:var(--grad);color:#fff;border-radius:12px;padding:18px;text-align:center}
.statbox .n{font-size:1.7rem;font-weight:700}
.statbox .l{font-size:.78rem;opacity:.9}
.risk-item{display:flex;gap:14px;align-items:flex-start;padding:14px;border-radius:10px;
 background:#faf9ff;margin:10px 0;border-left:5px solid #8E2DE2}
.risk-item .rk{font-size:1.4rem;font-weight:800;color:#8E2DE2;min-width:34px}
.acct-card{border:1px solid #ece8fb;border-radius:12px;margin:16px 0;overflow:hidden}
.acct-head{background:var(--grad);color:#fff;padding:14px 18px;display:flex;
 justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px}
.acct-head .who{font-weight:700}
.acct-body{padding:18px}
.ph-grid{display:flex;flex-wrap:wrap;gap:3px;margin:10px 0}
.ph-cell{width:34px;text-align:center;font-size:.62rem;border-radius:4px;padding:3px 0;color:#fff}
.ph-cell small{display:block;font-size:.55rem;opacity:.85;color:#2d3436}
.hbar{height:18px;border-radius:9px;background:#eee;overflow:hidden;margin:6px 0}
.hbar>span{display:block;height:100%;border-radius:9px}
.note{background:#fff8e6;border-left:5px solid var(--med);padding:12px 16px;border-radius:8px;margin:12px 0}
.issue{border-radius:10px;padding:18px;margin:14px 0}
.issue.c{background:#fdeef0;border-left:6px solid var(--crit)}
.issue.h{background:#fff3e9;border-left:6px solid var(--high)}
.issue.m{background:#fffbe9;border-left:6px solid var(--med)}
.issue h4{margin:0 0 6px}
.heat td{text-align:center;font-weight:600;color:#fff;font-size:.8rem}
.heat td.lbl{background:#fff;color:#2d3436;text-align:left;font-weight:600}
.hero-head{background:var(--grad);color:#fff;border-radius:0 0 18px 18px;padding:30px 16px 36px}
.brand{font-size:2rem;font-weight:800;letter-spacing:.5px}
.brand span{opacity:.85;font-weight:400;font-size:1rem}
.enq-table td{font-size:.85rem}
@media(max-width:760px){.grid2,.grid3,.gridkv{grid-template-columns:1fr}}
@media print{
 body{background:#fff}
 .card,.acct-card{box-shadow:none;border:1px solid #ddd;break-inside:avoid}
 .section-title{break-after:avoid}
 *{-webkit-print-color-adjust:exact;print-color-adjust:exact}
}
</style>
</head>
<body>

<!-- ═══════════════════════ HERO HEADER ═══════════════════════ -->
<div class="hero-head">
 <div class="container" style="padding-bottom:0">
  <div class="brand">VerifyHub <span>Credit Analysis Report</span></div>
 </div>
</div>

<div class="container">
 <div class="card" style="margin-top:-26px">
  <div class="grid2" style="align-items:center">
   <div>
    <div class="gridkv">
     <div class="kv"><b>Client Name</b><span><%- data.client_name || '—' %></span></div>
     <div class="kv"><b>Report Date</b><span><%- data.report_date || '—' %></span></div>
     <div class="kv"><b>PAN</b><span><%- data.pan || '—' %></span></div>
     <div class="kv"><b>Date of Birth</b><span><%- data.dob || '—' %></span></div>
     <div class="kv"><b>Bureau Control No</b><span><%- data.bureau_control_no || '—' %></span></div>
     <div class="kv"><b>Score Band</b><span><%- data.score_band || '—' %></span></div>
    </div>
    <p class="note" style="margin-top:16px">This report is an educational analysis of the credit data provided. It highlights what is helping and hurting the score, and gives a 90-day plan to improve it.</p>
   </div>
   <div style="text-align:center">
    <img class="chartimg" src="<%- chartUrls.scoreGauge %>" alt="Credit Score Gauge" style="max-width:420px;margin:auto">
    <h2 style="margin-top:10px">Current Score: <%- data.credit_score || '—' %> /900</h2>
    <span class="badge" style="background:<% if((data.credit_score||0)>=750){%>#28a745<%}else if((data.credit_score||0)>=700){%>#ffc107<%}else{%>#dc3545<%}%>;font-size:.95rem;padding:6px 18px">
     <%- data.score_band || '—' %>
    </span>
   </div>
  </div>
 </div>
</div>

<!-- ═══════════════════════ SECTION 01: Profile Snapshot ═══════════════════════ -->
<div class="container">
 <h2 class="section-title"><span class="section-no">01</span> Profile Snapshot</h2>
 <% if (profileNote) { %>
 <p class="note" style="margin:8px 0 14px">
  <strong>ℹ️ Portfolio context: </strong><%- profileNote %>
 </p>
 <% } %>
 <div class="card">
  <div class="grid3" style="margin-bottom:18px">
   <div class="statbox"><div class="n"><%- stats.totalAccounts %></div><div class="l">Total Accounts</div></div>
   <div class="statbox"><div class="n"><%- formatINR(stats.totalOutstanding) %></div><div class="l">Outstanding</div></div>
   <div class="statbox"><div class="n"><%- formatINR(stats.totalOverdue) %></div><div class="l">Amount Overdue</div></div>
   <div class="statbox"><div class="n"><%- stats.utilizationPct %>%</div><div class="l">Utilization</div></div>
   <div class="statbox"><div class="n"><%- stats.oldestVintage || '—' %></div><div class="l">Oldest Vintage</div></div>
   <div class="statbox"><div class="n"><%- enquiryCounts.enquiries_12m != null ? enquiryCounts.enquiries_12m : '—' %></div><div class="l">Enquiries (12m)</div></div>
  </div>

  <table>
   <thead><tr><th>Metric</th><th>Value</th><th>Read</th></tr></thead>
   <tbody>
    <tr><td>Total sanctioned (lifetime)</td><td><%- formatINR(stats.totalSanctioned) %></td><td>Across all closed, settled, and active lines</td></tr>
    <tr>
     <td>Total written-off / loss</td>
     <td style="color:#dc3545;font-weight:700"><%- formatINR(stats.totalWrittenOff) %></td>
     <td><%- stats.totalWrittenOff > 0 ? accounts.filter(function(a){return (a.written_off_amount||0)>0}).map(function(a){return a.lender}).join(', ') : 'None' %></td>
    </tr>
     <tr><td>Secured exposure</td>
      <% if (stats.hasActiveBalance) { %>
      <td><%- formatINR(stats.securedOutstanding) %></td><td>Home, vehicle, gold, property loans</td>
      <% } else { %>
      <td><%- formatINR(stats.securedSanctioned) %></td><td>Lifetime sanctioned amount — no balance currently owed</td>
      <% } %>
     </tr>
     <tr><td>Unsecured exposure</td>
      <% if (stats.hasActiveBalance) { %>
      <td><%- formatINR(stats.unsecuredOutstanding) %></td><td>Credit cards, personal loans, consumer credit</td>
      <% } else { %>
      <td><%- formatINR(stats.unsecuredSanctioned) %></td><td>Lifetime sanctioned amount — no balance currently owed</td>
      <% } %>
     </tr>
    <tr><td>Active accounts</td><td><%- stats.activeAccounts %></td><td>Currently open and reporting</td></tr>
    <% if(data.foir_percent != null){ %>
    <tr><td>FOIR (Fixed Obligation Ratio)</td><td><%- data.foir_percent %>%</td><td><%- data.foir_rating || '—' %></td></tr>
    <% } %>
    <% if(data.max_eligible_amount){ %>
    <tr><td>Max Eligible Loan Amount</td><td><%- formatINR(data.max_eligible_amount) %></td><td>Estimated based on income signals in report</td></tr>
    <% } %>
   </tbody>
  </table>

  <div class="grid2">
   <div>
    <h4 style="text-align:center">Portfolio Mix (Secured vs Unsecured)<%- chartUrls.portfolioMix && chartUrls.portfolioMix.isLifetimeView ? ' — Lifetime Sanctioned' : '' %></h4>
    <% if (chartUrls.portfolioMix) { %>
     <img class="chartimg" src="<%- chartUrls.portfolioMix.url %>" alt="Portfolio Mix">
    <% } else { %>
     <div style="background:#faf9ff; border:1px solid #ece8fb; border-radius:8px; padding:30px; text-align:center; color:var(--muted); font-size:.9rem; min-height:180px; display:flex; align-items:center; justify-content:center;">
      No active outstanding exposure to map.
     </div>
    <% } %>
   </div>
   <div>
    <h4 style="text-align:center">Risk Severity Distribution</h4>
    <img class="chartimg" src="<%- chartUrls.riskSeverity %>" alt="Risk Severity">
   </div>
  </div>
  <div class="grid2" style="margin-top:18px">
   <div>
    <h4 style="text-align:center">Accounts by Type</h4>
    <% if (chartUrls.accountsByType) { %>
     <img class="chartimg" src="<%- chartUrls.accountsByType %>" alt="Accounts by Type">
    <% } else { %>
     <div style="background:#faf9ff; border:1px solid #ece8fb; border-radius:8px; padding:30px; text-align:center; color:var(--muted); font-size:.9rem; min-height:180px; display:flex; align-items:center; justify-content:center;">
      No accounts on file to classify.
     </div>
    <% } %>
   </div>
   <div>
    <h4 style="text-align:center">Accounts by Lender</h4>
    <% if (chartUrls.accountsByLender) { %>
     <img class="chartimg" src="<%- chartUrls.accountsByLender %>" alt="Accounts by Lender">
    <% } else { %>
     <div style="background:#faf9ff; border:1px solid #ece8fb; border-radius:8px; padding:30px; text-align:center; color:var(--muted); font-size:.9rem; min-height:180px; display:flex; align-items:center; justify-content:center;">
      No accounts on file to group.
     </div>
    <% } %>
   </div>
  </div>
 </div>
</div>

<!-- ═══════════════════════ SECTION 02: Top Risk Factors ═══════════════════════ -->
<div class="container">
 <h2 class="section-title"><span class="section-no">02</span> Top Risk Factors</h2>
 <p class="lead">The negative items below are, in order, pulling the score down the most.</p>
 <div class="card">
  <% riskFactors.forEach(function(rf, i){ %>
  <div class="risk-item" style="border-left-color:<%- rf._color %>">
   <div class="rk"><%- i + 1 %></div>
   <div>
    <span class="badge b-<%- rf.severity %>"><%- rf.severity %></span>
    <div style="font-weight:700;margin:6px 0 4px"><%- rf.title %></div>
    <div style="color:#444;font-size:.9rem"><%- rf.explanation %></div>
   </div>
  </div>
  <% }); %>
  <% if(!riskFactors.length){ %><p style="color:var(--muted)">No significant risk factors identified.</p><% } %>
 </div>
</div>

<!-- ═══════════════════════ SECTION 03: Portfolio Analysis ═══════════════════════ -->
<div class="container">
 <h2 class="section-title"><span class="section-no">03</span> Portfolio Analysis — All Accounts</h2>
 <div class="card">
  <div style="overflow-x:auto">
   <table>
    <thead>
     <tr><th>Lender</th><th>Type</th><th>Sanctioned</th><th>Balance</th><th>Util %</th><th>Max DPD</th><th>Status</th><th>Risk</th></tr>
    </thead>
    <tbody>
     <% accounts.forEach(function(acct){ %>
     <tr>
      <td><%- acct.lender %></td>
      <td><%- acct.account_type %></td>
      <td><%- formatINR(acct.sanctioned_amount) %></td>
      <td><%- formatINR(acct.current_balance) %></td>
      <td><%- acct._utilPct %>%</td>
      <td><%- acct.max_dpd || 0 %></td>
      <td><%- acct.status || '—' %></td>
      <td><span class="badge b-<%- acct._severity %>"><%- acct._severity %></span></td>
     </tr>
     <% }); %>
    </tbody>
   </table>
  </div>
  <div class="grid2" style="margin-top:18px">
   <div>
    <h4 style="text-align:center"><%- chartUrls.outstandingVsSanct && chartUrls.outstandingVsSanct.isLifetimeView ? 'Lifetime Sanctioned by Lender' : 'Outstanding / Loss vs Sanctioned' %></h4>
    <% if (chartUrls.outstandingVsSanct) { %>
     <img class="chartimg" src="<%- chartUrls.outstandingVsSanct.url %>" alt="Outstanding vs Sanctioned">
    <% } else { %>
     <div style="background:#faf9ff; border:1px solid #ece8fb; border-radius:8px; padding:30px; text-align:center; color:var(--muted); font-size:.9rem; min-height:180px; display:flex; align-items:center; justify-content:center;">
      No active outstanding or written-off balances.
     </div>
    <% } %>
   </div>
   <div>
    <h4 style="text-align:center">Risk Map (DPD vs Account Health)</h4>
    <img class="chartimg" src="<%- chartUrls.riskMap %>" alt="Risk Map">
   </div>
  </div>
 </div>
</div>

<!-- ═══════════════════════ SECTION 04: Detailed Account Breakdown ═══════════════════════ -->
<div class="container">
 <h2 class="section-title"><span class="section-no">04</span> Detailed Account Breakdown</h2>
 <p class="lead">Every account on the report, with health score and month-by-month payment history.</p>
 <div class="card">
  <div style="display:flex;gap:14px;flex-wrap:wrap;font-size:.8rem;margin:8px 0 16px">
   <span><b style="color:#28a745">■</b> On-time (OK)</span>
   <span><b style="color:#ffc107">■</b> 1–29 DPD</span>
   <span><b style="color:#fd7e14">■</b> 30–89 DPD</span>
   <span><b style="color:#dc3545">■</b> 90+ / SUB / SMA</span>
   <span><b style="color:#adb5bd">■</b> Not reported (NR / XXX)</span>
  </div>

  <% accounts.forEach(function(acct){ %>
  <div class="acct-card">
   <div class="acct-head">
    <div class="who"><%- acct.lender %> &nbsp;·&nbsp; <%- acct.account_type %></div>
    <span class="badge b-<%- acct._severity %>"><%- acct._severity %></span>
   </div>
   <div class="acct-body">
    <div class="gridkv">
     <div class="kv"><b>Account No</b><span><%- acct.masked_account_number || '—' %></span></div>
     <div class="kv"><b>Ownership</b><span><%- acct.ownership || '—' %></span></div>
     <div class="kv"><b>Opened</b><span><%- acct.opened_date || '—' %></span></div>
     <div class="kv"><b>Closed</b><span><%- acct.closed_date || 'Active' %></span></div>
     <div class="kv"><b>Sanctioned</b><span><%- formatINR(acct.sanctioned_amount) %></span></div>
     <div class="kv"><b>Balance</b><span><%- formatINR(acct.current_balance) %></span></div>
     <div class="kv"><b>Overdue</b><span><%- formatINR(acct.overdue_amount) %></span></div>
     <div class="kv"><b>Max DPD</b><span><%- acct.max_dpd || 0 %> days</span></div>
     <% if((acct.written_off_amount||0) > 0){ %>
     <div class="kv"><b>Written Off</b><span style="color:#dc3545;font-weight:700"><%- formatINR(acct.written_off_amount) %></span></div>
     <% } %>
     <% if(acct.suit_filed){ %>
     <div class="kv"><b>Suit Filed</b><span style="color:#dc3545;font-weight:700">Yes</span></div>
     <% } %>
     <% if(acct.emi_amount){ %>
     <div class="kv"><b>EMI</b><span><%- formatINR(acct.emi_amount) %>/mo</span></div>
     <% } %>
    </div>

    <%# Health bar --%>
    <div style="margin-top:14px">
     <b style="font-size:.85rem">Account Health: <%- acct._healthScore %>/100</b>
     <div class="hbar">
      <span style="width:<%- acct._healthScore %>%;background:<%- acct._severityColor %>"></span>
     </div>
    </div>

    <%# Payment history grid --%>
    <% if(acct.dpd_history && acct.dpd_history.length > 0){ %>
    <div style="margin-top:14px">
     <b style="font-size:.85rem">Payment history (most recent first)</b>
     <div class="ph-grid">
      <% acct.dpd_history.forEach(function(h){ %>
      <div class="ph-cell" style="background:<%- dpdCodeToColor(h.value) %>">
       <small><%- h.month %></small><%- h.value %>
      </div>
      <% }); %>
     </div>
    </div>
    <% } %>

    <%# DPD history bar chart — only for delinquent accounts --%>
    <% if((acct.max_dpd||0) > 0 && chartUrls.dpdCharts[acct.masked_account_number]){ %>
    <h4 style="margin-top:16px">Days-Past-Due History</h4>
    <img class="chartimg" src="<%- chartUrls.dpdCharts[acct.masked_account_number] %>" alt="DPD history for <%- acct.lender %>">
    <% } %>
   </div>
  </div>
  <% }); %>
 </div>
</div>

<!-- ═══════════════════════ SECTION 05: Strategic Analysis ═══════════════════════ -->
<div class="container">
 <h2 class="section-title"><span class="section-no">05</span> Strategic Analysis</h2>
 <div class="card">
  <h4>Health Heatmap</h4>
  <div style="overflow-x:auto">
   <table class="heat">
    <thead>
     <tr>
      <th style="background:var(--grad);color:#fff;text-align:left">Account</th>
      <th style="background:var(--grad);color:#fff">Max DPD</th>
      <th style="background:var(--grad);color:#fff">Health</th>
      <th style="background:var(--grad);color:#fff">Written-off</th>
      <th style="background:var(--grad);color:#fff">Overdue</th>
     </tr>
    </thead>
    <tbody>
     <% accounts.forEach(function(acct){ %>
     <tr>
      <td class="lbl"><%- acct.lender %> · <%- acct.account_type %></td>
      <td style="background:<%- acct._severityColor %>"><%- acct.max_dpd || 0 %></td>
      <td style="background:<%- acct._severityColor %>"><%- acct._healthScore %></td>
      <td style="background:<%= (acct.written_off_amount||0)>0 ? '#dc3545' : '#28a745' %>"><%- (acct.written_off_amount||0) > 0 ? 'Yes' : 'No' %></td>
      <td style="background:<%= (acct.overdue_amount||0)>0 ? '#dc3545' : '#28a745' %>"><%- (acct.overdue_amount||0) > 0 ? 'Yes' : 'No' %></td>
     </tr>
     <% }); %>
    </tbody>
   </table>
  </div>

  <h4 style="margin-top:24px">Risk Concentration</h4>
  <p style="color:#444;line-height:1.7"><%- data.risk_concentration_paragraph || 'Analysis not available.' %></p>

  <%# Enquiries table (if any) --%>
  <% if(enquiries && enquiries.length > 0){ %>
  <h4 style="margin-top:24px">Credit Enquiries (<%- enquiries.length %> total)</h4>
  <div style="overflow-x:auto">
   <table class="enq-table">
    <thead><tr><th>Member</th><th>Date</th><th>Purpose</th><th>Amount</th></tr></thead>
    <tbody>
     <% enquiries.forEach(function(enq){ %>
     <tr>
      <td><%- enq.member || '—' %></td>
      <td><%- enq.date || '—' %></td>
      <td><%- enq.purpose || '—' %></td>
      <td><%- enq.amount ? formatINR(enq.amount) : '—' %></td>
     </tr>
     <% }); %>
    </tbody>
   </table>
  </div>
  <% } %>
 </div>
</div>

<!-- ═══════════════════════ SECTION 06: 90-Day Action Plan ═══════════════════════ -->
<div class="container">
 <h2 class="section-title"><span class="section-no">06</span> 90-Day Action Plan</h2>
 <div class="card">
  <div class="grid3">
   <div class="issue c">
    <h4>Month 1 — Immediate</h4>
    <p><%- data.action_month_1 || 'Action steps not available.' %></p>
   </div>
   <div class="issue m">
    <h4>Month 2 — Stabilize</h4>
    <p><%- data.action_month_2 || 'Action steps not available.' %></p>
   </div>
   <div class="issue h" style="border-left-color:#28a745;background:#eafaef">
    <h4>Month 3 — Accelerate</h4>
    <p><%- data.action_month_3 || 'Action steps not available.' %></p>
   </div>
  </div>

  <h4 style="margin-top:24px;text-align:center">Projected Score Trajectory</h4>
  <img class="chartimg" src="<%- chartUrls.projectedScore %>" alt="Projected Score" style="max-width:640px;margin:auto;display:block">

  <p class="note" style="margin-top:16px">
   <%- data.projection_assumptions || 'Projection assumes timely payments, no new hard enquiries, and resolution of overdue accounts.' %>
  </p>

  <% if(data.recommendation){ %>
  <div style="background:var(--grad);color:#fff;border-radius:10px;padding:18px;margin-top:18px;text-align:center">
   <b style="font-size:1.05rem">📋 Overall Recommendation</b>
   <p style="margin:8px 0 0;opacity:.95"><%- data.recommendation %></p>
  </div>
  <% } %>
 </div>
</div>

<!-- ═══════════════════════ FOOTER ═══════════════════════ -->
<div class="container">
 <div style="margin-top:50px;padding:30px;background:#2d3436;color:white;text-align:center;border-radius:12px 12px 0 0;">
  <h3 style="margin:0 0 8px">Report Generated by VerifyHub</h3>
  <p style="margin:0 0 12px;opacity:.85">Empowering Financial Freedom</p>
