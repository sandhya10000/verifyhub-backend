<!DOCTYPE html>
<html lang="<%- lang %>"<%- isRTL ? ' dir="rtl"' : '' %>>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%- t('report_title') %> — <%- data.client_name || 'Client' %></title>
<% if (lang !== 'en') { %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<%
  const fontMap = {
    hi:'Noto+Sans+Devanagari', mr:'Noto+Sans+Devanagari', as:'Noto+Sans+Devanagari',
    ta:'Noto+Sans+Tamil', te:'Noto+Sans+Telugu', kn:'Noto+Sans+Kannada',
    bn:'Noto+Sans+Bengali', gu:'Noto+Sans+Gujarati', pa:'Noto+Sans+Gurmukhi',
    ml:'Noto+Sans+Malayalam', or:'Noto+Sans+Oriya',
    ur:'Noto+Nastaliq+Urdu'
  };
  const fontFamily = fontMap[lang];
%>
<% if (fontFamily) { %>
<link href="https://fonts.googleapis.com/css2?family=<%- fontFamily %>:wght@400;600;700&display=swap" rel="stylesheet">
<% } %>
<% } %>
<style>
:root{
  --grad:linear-gradient(135deg,#4A00E0 0%,#8E2DE2 100%);
  --crit:#dc3545;--high:#fd7e14;--med:#ffc107;--low:#28a745;
  --bg:#f4f6f9;--card:#fff;--ink:#2d3436;--muted:#6b7280;
  --hero-accent:linear-gradient(90deg,#4A00E0 0%,#a855f7 40%,#8E2DE2 70%,#06b6d4 100%);
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);
  font-family:
    '<%- (() => {
      const m = {hi:'Noto Sans Devanagari',mr:'Noto Sans Devanagari',as:'Noto Sans Devanagari',
        ta:'Noto Sans Tamil',te:'Noto Sans Telugu',kn:'Noto Sans Kannada',
        bn:'Noto Sans Bengali',gu:'Noto Sans Gujarati',pa:'Noto Sans Gurmukhi',
        ml:'Noto Sans Malayalam',or:'Noto Sans Oriya',ur:'Noto Nastaliq Urdu'};
      return m[lang] || '';
    })() %>',
    'Segoe UI',Roboto,Helvetica,Arial,sans-serif;line-height:1.55}
p, td, th, div, span, h1, h2, h3, h4 {
  overflow-wrap: break-word;
  word-break: break-word;
}
.container{max-width:1200px;margin:0 auto;padding:0 16px 60px}
.card{background:var(--card);border-radius:12px;box-shadow:0 4px 6px rgba(0,0,0,.1);
  padding:26px;margin:22px 0}
.hero-card{box-shadow:none;border-radius:0 0 12px 12px;margin-top:0;}
h1,h2,h3,h4{margin:0 0 12px}
.section-title{font-size:1.45rem;border-left:6px solid #8E2DE2;padding-left:12px;margin:34px 0 6px}
<% if (isRTL) { %>
.section-title{border-left:none;border-right:6px solid #8E2DE2;padding-left:0;padding-right:12px}
<% } %>
.section-no{color:#8E2DE2;font-weight:700}
.lead{color:var(--muted);margin:0 0 18px;padding-left:18px}
<% if (isRTL) { %>.lead{padding-left:0;padding-right:18px}<% } %>
table{width:100%;border-collapse:collapse;margin:14px 0;font-size:.92rem}
th{background:var(--grad);color:#fff;padding:11px 10px;text-align:<%- isRTL ? 'right' : 'left' %>;font-weight:600}
td{padding:10px;border-bottom:1px solid #eef0f4}
tbody tr:hover{background:#f7f4ff}

/* ── Badges ─────────────────────────────────────────────────────────────── */
.badge{display:inline-flex;align-items:center;gap:4px;padding:4px 12px;
  border-radius:20px;color:#fff;font-size:.72rem;font-weight:700;
  letter-spacing:.3px;border:none}
.b-CRITICAL{
  background:linear-gradient(135deg,#dc3545 0%,#b02030 100%);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.25),0 2px 6px rgba(220,53,69,.4)}
.b-HIGH{
  background:linear-gradient(135deg,#fd7e14 0%,#d96209 100%);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.25),0 2px 6px rgba(253,126,20,.4)}
.b-MEDIUM{
  background:linear-gradient(135deg,#ffc107 0%,#d4980a 100%);color:#5a4b00;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.3),0 2px 6px rgba(255,193,7,.35)}
.b-LOW{
  background:linear-gradient(135deg,#28a745 0%,#1a7a32 100%);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.25),0 2px 6px rgba(40,167,69,.4)}
.score-badge{
  font-size:.95rem;padding:7px 20px;border-radius:24px;
  display:inline-flex;align-items:center;gap:6px}

.grid2{display:grid;grid-template-columns:1fr 1fr;gap:22px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.gridkv{display:grid;grid-template-columns:repeat(2,1fr);gap:8px 26px;font-size:.9rem}

/* ── Client detail grid — two columns with a centre divider ─────────────── */
.hero-gridkv{
  display:grid;
  grid-template-columns:1fr 4px 1fr;
  gap:8px 0;
  font-size:.9rem}
.gridkv-divider{
  grid-column:2;
  grid-row:2 / -1;
  width:1px;
  background:#e3e6ee;
  margin:0 16px;
  align-self:stretch}
.kv-left { grid-column: 1; }
.kv-right { grid-column: 3; }
.kv{display:flex;align-items:center;gap:12px;border-bottom:1px dotted #e3e6ee;padding:12px 4px}
.kv b{font-weight:600;display:block;color:#6b7280;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:3px}
.kv-icon-wrap{width:36px;height:36px;border-radius:50%;background:#eff6ff;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.kv-icon{stroke:#3b82f6;}
.kv-content{display:flex;flex-direction:column}
.kv span{color:var(--ink);font-size:.95rem;font-weight:600;}

.chartimg{width:100%;height:auto;border-radius:8px;display:block}
.statbox{background:var(--grad);color:#fff;border-radius:12px;padding:18px;text-align:center}
.statbox .n{font-size:1.7rem;font-weight:700}
.statbox .l{font-size:.78rem;opacity:.9}
.risk-item{display:flex;gap:14px;align-items:flex-start;padding:14px;border-radius:10px;
  background:#faf9ff;margin:10px 0;border-left:5px solid #8E2DE2}
<% if (isRTL) { %>.risk-item{border-left:none;border-right:5px solid #8E2DE2}<% } %>
.risk-item .rk{font-size:1.4rem;font-weight:800;color:#8E2DE2;min-width:34px}
.acct-card{border:1px solid #ece8fb;border-radius:12px;margin:16px 0;overflow:hidden}
.acct-head{background:var(--grad);color:#fff;padding:14px 18px;display:flex;
  justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px}
.acct-head .who{font-weight:700}
.acct-body{padding:18px}
.ph-grid{display:flex;flex-wrap:wrap;gap:3px;margin:10px 0}
.ph-cell{width:34px;text-align:center;font-size:.62rem;border-radius:4px;padding:3px 0;color:#fff}
.ph-cell small{display:block;font-size:.55rem;opacity:.85;color:#2d3436}
.hbar{height:18px;border-radius:9px;background:#eee;overflow:hidden;margin:6px 0}
.hbar>span{display:block;height:100%;border-radius:9px}
.note{background:#f1f5f9;border-left:5px solid #3b82f6;padding:12px 16px;border-radius:8px;margin:12px 0;display:flex;gap:12px;align-items:flex-start}
<% if (isRTL) { %>.note{border-left:none;border-right:5px solid #3b82f6}<% } %>
.issue{border-radius:10px;padding:18px;margin:14px 0}
.issue.c{background:#fdeef0;border-left:6px solid var(--crit)}
.issue.h{background:#fff3e9;border-left:6px solid var(--high)}
.issue.m{background:#fffbe9;border-left:6px solid var(--med)}
<% if (isRTL) { %>
.issue.c,.issue.h,.issue.m{border-left:none}
.issue.c{border-right:6px solid var(--crit)}
.issue.h{border-right:6px solid var(--high)}
.issue.m{border-right:6px solid var(--med)}
<% } %>
.issue h4{margin:0 0 6px}
.heat td{text-align:center;font-weight:600;color:#fff;font-size:.8rem}
.heat td.lbl{background:#fff;color:#2d3436;text-align:<%- isRTL ? 'right' : 'left' %>;font-weight:600}

/* ── Hero Header ─────────────────────────────────────────────────────────── */
.hero-head{
  position:relative;
  color:#fff;
  border-radius:0 0 18px 18px;
  padding:32px 16px 40px;
  overflow:hidden;
  background:
    repeating-linear-gradient(
      -45deg,
      rgba(255,255,255,0) 0px,
      rgba(255,255,255,0) 18px,
      rgba(255,255,255,.045) 18px,
      rgba(255,255,255,.045) 19px
    ),
    radial-gradient(circle, rgba(255,255,255,.07) 1px, transparent 1px) 0 0 / 28px 28px,
    linear-gradient(135deg,#0f1b3d 0%,#1a9e8f 100%);
}

/* ── Brand wordmark hierarchy ────────────────────────────────────────────── */
.brand{
  display:flex;
  flex-direction:column;
  gap:0;
  line-height:1
}
.brand-wordmark{
  font-size:2.15rem;
  font-weight:900;
  letter-spacing:-.5px;
  display:flex;
  align-items:center;
  gap:10px
}
.brand-divider{
  width:48px;
  height:3px;
  border-radius:2px;
  background:linear-gradient(90deg,rgba(255,255,255,.9),rgba(255,255,255,.2));
  margin:7px 0 6px
}
.brand-sub{
  font-size:.95rem;
  font-weight:300;
  letter-spacing:2.5px;
  text-transform:uppercase;
  opacity:.82
}
.hero-ai-badge{
  background:rgba(255,255,255,0.1);
  border:1px solid rgba(255,255,255,0.2);
  border-radius:12px;
  padding:12px 16px;
  display:inline-flex;
  flex-direction:column;
  align-items:flex-start;
  gap:4px;
}
.hero-ai-badge-top{
  font-size:0.95rem;
  font-weight:700;
  display:flex;
  align-items:center;
  gap:8px;
}
.hero-ai-badge-sub{
  font-size:0.75rem;
  opacity:0.8;
  font-weight:400;
}
.hero-flex{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
}

/* ── Score gauge drop-shadow wrapper ─────────────────────────────────────── */
.gauge-wrap{
  display:inline-block;
  filter:drop-shadow(0 8px 24px rgba(74,0,224,.35)) drop-shadow(0 2px 6px rgba(0,0,0,.18));
}

.enq-table td{font-size:.85rem}

@media(max-width:760px){
  .grid2,.grid3{grid-template-columns:1fr}
  .gridkv{grid-template-columns:1fr}
  .hero-gridkv{grid-template-columns:1fr; gap:16px 0}
  .gridkv-divider{display:none}
  .kv-left, .kv-right { grid-column: 1; grid-row: auto !important; }
  .hero-flex{flex-direction:column; gap:16px}
  .brand-wordmark{flex-wrap:wrap; font-size:1.6rem}
  .hero-ai-badge{width:100%}
  .acct-head{flex-direction:column; align-items:flex-start}
}
@media print{
  body{background:#fff}
  .card,.acct-card{box-shadow:none;border:1px solid #ddd;break-inside:avoid}
  .section-title{break-after:avoid}
  .hero-head{
    background:linear-gradient(135deg,#4A00E0 0%,#8E2DE2 100%) !important;
  }
  .gauge-wrap{filter:none !important}
  *{-webkit-print-color-adjust:exact;print-color-adjust:exact}
}
</style>
</head>
<body>

<!-- ═══════════════════════ HERO HEADER ═══════════════════════ -->
<div class="hero-head">
<div class="container" style="padding-bottom:0">
  <div class="hero-flex">
   <div class="brand">
    <div class="brand-wordmark">
     <img src="<%- logoDataUri %>" alt="VerifyHub" style="height:75px;width:auto;margin-right:16px;">
     <span style="font-size:1.5rem; letter-spacing:1px; text-transform:uppercase;"><%- t('report_title') %></span>
    </div>
    <div class="brand-sub" style="margin-top:12px; display:flex; align-items:center; gap:8px; text-transform:none; letter-spacing:0.5px; font-weight:400; font-size:0.9rem;">
     <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z" fill="#facc15"/></svg>
     <%- t('hero_tagline') %>
    </div>
   </div>
   <div class="hero-ai-badge">
    <div class="hero-ai-badge-top">
     <svg width="14" height="14" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="6" cy="6" r="5.5" stroke="rgba(255,255,255,0.9)" stroke-width="1.2"/>
      <polyline points="3.5,6.2 5.2,7.8 8.5,4.5" stroke="rgba(255,255,255,1)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
     </svg>
     <%- t('hero_ai_verified') %>
    </div>
    <div class="hero-ai-badge-sub"><%- t('hero_ai_trusted') %></div>
   </div>
  </div>
 </div>
</div>

<div class="container">
 <div class="card hero-card">
  <div class="grid2" style="align-items:center">
   <div>
    <!-- Client detail grid with centre divider -->
    <div class="hero-gridkv">
     <!-- LEFT COLUMN HEADER -->
     <div class="kv-left" style="grid-row: 1; display:flex; align-items:center; gap:8px; color:#4A00E0; font-weight:700; font-size:0.85rem; letter-spacing:0.5px; padding-bottom:8px;">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="8" cy="5" r="3" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M2 14c0-3.3 2.7-6 6-6s6 2.7 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/></svg>
      <%- t('client_information') %>
     </div>

     <!-- LEFT COLUMN -->
     <div class="kv kv-left" style="grid-row: 2;">
      <div class="kv-icon-wrap">
       <svg class="kv-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="8" cy="5" r="3" stroke-width="1.5" fill="none"/><path d="M2 14c0-3.3 2.7-6 6-6s6 2.7 6 6" stroke-width="1.5" stroke-linecap="round" fill="none"/></svg>
      </div>
      <div class="kv-content">
       <b><%- t('client_name') %></b>
       <span><%- data.client_name || '—' %></span>
      </div>
     </div>

     <div class="kv kv-left" style="grid-row: 3;">
      <div class="kv-icon-wrap">
       <svg class="kv-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="1" y="3" width="14" height="10" rx="2" stroke-width="1.5" fill="none"/><line x1="5" y1="7" x2="11" y2="7" stroke-width="1.2" stroke-linecap="round"/><line x1="5" y1="9.5" x2="9" y2="9.5" stroke-width="1.2" stroke-linecap="round"/></svg>
      </div>
      <div class="kv-content">
       <b><%- t('pan') %></b>
       <span><%- data.pan || '—' %></span>
      </div>
     </div>

     <div class="kv kv-left" style="grid-row: 4;">
      <div class="kv-icon-wrap">
       <svg class="kv-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><line x1="4" y1="3" x2="4" y2="13" stroke-width="1.5" stroke-linecap="round"/><line x1="12" y1="3" x2="12" y2="13" stroke-width="1.5" stroke-linecap="round"/><line x1="2" y1="6" x2="14" y2="6" stroke-width="1.5" stroke-linecap="round"/><line x1="2" y1="10" x2="14" y2="10" stroke-width="1.5" stroke-linecap="round"/></svg>
      </div>
      <div class="kv-content">
       <b><%- t('bureau_control_no') %></b>
       <span><%- data.bureau_control_no || '—' %></span>
      </div>
     </div>

     <!-- Centre divider -->
     <div class="gridkv-divider" aria-hidden="true"></div>

     <!-- RIGHT COLUMN HEADER -->
     <div class="kv-right" style="grid-row: 1; display:flex; align-items:center; gap:8px; color:#4A00E0; font-weight:700; font-size:0.85rem; letter-spacing:0.5px; padding-bottom:8px; padding-top:16px;">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><polyline points="2,12 6,7 9,10 14,4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/><polyline points="10,4 14,4 14,8" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <%- t('credit_score_overview') %>
     </div>

     <!-- RIGHT COLUMN -->
     <div class="kv kv-right" style="grid-row: 2;">
      <div class="kv-icon-wrap">
       <svg class="kv-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="1" y="3" width="14" height="12" rx="2" stroke-width="1.5" fill="none"/><line x1="1" y1="7" x2="15" y2="7" stroke-width="1.2"/><line x1="5" y1="1" x2="5" y2="5" stroke-width="1.5" stroke-linecap="round"/><line x1="11" y1="1" x2="11" y2="5" stroke-width="1.5" stroke-linecap="round"/></svg>
      </div>
      <div class="kv-content">
       <b><%- t('report_date') %></b>
       <span><%- data.report_date || '—' %></span>
      </div>
     </div>

     <div class="kv kv-right" style="grid-row: 3;">
      <div class="kv-icon-wrap">
       <svg class="kv-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="1" y="7" width="14" height="8" rx="1.5" stroke-width="1.5" fill="none"/><line x1="8" y1="7" x2="8" y2="15" stroke-width="1.2"/><path d="M4 7c0-2 2-4 4-4s4 2 4 4" stroke-width="1.2" fill="none" stroke-linecap="round"/></svg>
      </div>
      <div class="kv-content">
       <b><%- t('date_of_birth') %></b>
       <span><%- data.dob || '—' %></span>
      </div>
     </div>

     <div class="kv kv-right" style="grid-row: 4;">
      <div class="kv-icon-wrap">
       <svg class="kv-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M1 8.5L8.5 1H15v6.5L7.5 15 1 8.5z" stroke-width="1.5" stroke-linejoin="round" fill="none"/><circle cx="11.5" cy="4.5" r="1.5" fill="currentColor"/></svg>
      </div>
      <div class="kv-content">
       <b><%- t('score_band') %></b>
       <span style="color:<%= data.score_band === 'Fair' ? '#d4980a' : (data.score_band === 'Good' || data.score_band === 'Excellent' ? '#1a7a32' : '#b02030') %>"><%- tScoreBand(data.score_band) || '—' %></span>
      </div>
     </div>

    </div><!-- /gridkv -->
    <div class="note" style="margin-top:16px">
     <div style="background:#3b82f6; color:#fff; width:22px; height:22px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:bold; font-size:12px; flex-shrink:0;">i</div>
     <div><%- t('disclaimer_note') %></div>
    </div>
   </div>

   <!-- Score gauge + badge -->
   <div style="text-align:center">
    <div class="gauge-wrap" style="display:inline-block">
     <img class="chartimg" src="<%- chartUrls.scoreGauge %>" alt="<%- t('current_score', {score: data.credit_score || 0}) %>" style="max-width:420px;margin:auto">
    </div>
    <h2 style="margin-top:12px"><%- t('current_score', {score: data.credit_score || '—'}) %></h2>
    <!-- Gradient score-band badge with directional chevron -->
    <% var _sc = data.credit_score || 0; var _sb = tScoreBand(data.score_band) || '—'; %>
    <% var _bgGrad = _sc >= 750 ? 'linear-gradient(135deg,#28a745 0%,#1a7a32 100%)' : _sc >= 700 ? 'linear-gradient(135deg,#ffc107 0%,#d4980a 100%)' : 'linear-gradient(135deg,#dc3545 0%,#b02030 100%)'; %>
    <% var _shadow = _sc >= 750 ? 'rgba(40,167,69,.45)' : _sc >= 700 ? 'rgba(255,193,7,.45)' : 'rgba(220,53,69,.45)'; %>
    <% var _txtColor = _sc >= 700 && _sc < 750 ? '#5a4b00' : '#fff'; %>
    <span class="badge score-badge" style="background:<%- _bgGrad %>;box-shadow:inset 0 1px 0 rgba(255,255,255,.28),0 4px 14px <%- _shadow %>;color:<%- _txtColor %>">
     <% if(_sc >= 700){ %>
     <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><polyline points="2,9 6,4 10,9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
     <% } else if(_sc >= 600){ %>
     <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><polyline points="3,6 9,6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><polyline points="7,3 10,6 7,9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
     <% } else { %>
     <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><polyline points="2,3 6,8 10,3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
     <% } %>
     <%- _sb %>
    </span>
   </div>
  </div>
 </div>
</div>

<!-- ═══════════════════════ EXECUTIVE SUMMARY ═══════════════════════ -->
<div class="container" style="padding-top:0; padding-bottom:0">
 <div class="card" style="border-left:5px solid #8E2DE2; margin-top:0; margin-bottom:16px<% if(isRTL){ %>; border-left:none; border-right:5px solid #8E2DE2<% } %>">
  <div style="font-size:0.85rem; font-weight:700; color:#8E2DE2; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px"><%- t('executive_summary') %></div>
  <p style="font-size:1.05rem; margin:0; line-height:1.6"><%- data.executive_summary || t('no_executive_summary') %></p>
 </div>
</div>

<!-- ═══════════════════════ QUICK TAKEAWAYS ═══════════════════════ -->
<div class="container" style="padding-top:0; padding-bottom:16px">
 <div class="grid3">
  <!-- What's Helping -->
  <div style="background:#eafaef; border:1px solid #d1f4e0; border-radius:10px; padding:16px; display:flex; gap:12px; align-items:flex-start;">
   <div style="background:#28a745; border-radius:50%; width:28px; height:28px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
   </div>
   <div>
    <h4 style="margin:0 0 4px; color:#1a7a32; font-size:0.95rem;"><%- t('whats_helping') %></h4>
    <p style="margin:0; font-size:0.9rem; color:#2d3436; line-height:1.4;"><%- data.whats_helping || t('no_positive_factors') %></p>
   </div>
  </div>

  <!-- What's Hurting -->
  <div style="background:#fdeef0; border:1px solid #fad3d8; border-radius:10px; padding:16px; display:flex; gap:12px; align-items:flex-start;">
   <div style="background:#dc3545; border-radius:50%; width:28px; height:28px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3zm7-13h3a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-3" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
   </div>
   <div>
    <h4 style="margin:0 0 4px; color:#b02030; font-size:0.95rem;"><%- t('whats_hurting') %></h4>
    <p style="margin:0; font-size:0.9rem; color:#2d3436; line-height:1.4;"><%- data.whats_hurting || t('no_negative_factors') %></p>
   </div>
  </div>

  <!-- Top Priority -->
  <div style="background:#eff6ff; border:1px solid #dbeafe; border-radius:10px; padding:16px; display:flex; gap:12px; align-items:flex-start;">
   <div style="background:#3b82f6; border-radius:50%; width:28px; height:28px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#fff" stroke-width="2"/><circle cx="12" cy="12" r="6" stroke="#fff" stroke-width="2"/><circle cx="12" cy="12" r="2" fill="#fff"/></svg>
   </div>
   <div>
    <h4 style="margin:0 0 4px; color:#1d4ed8; font-size:0.95rem;"><%- t('top_priority') %></h4>
    <p style="margin:0; font-size:0.9rem; color:#2d3436; line-height:1.4;"><%- data.top_priority || t('no_priorities_found') %></p>
   </div>
  </div>
 </div>
</div>

<!-- ═══════════════════════ SECTION 01: Profile Snapshot ═══════════════════════ -->
<div class="container">
 <h2 class="section-title"><span class="section-no">01</span> <%- t('profile_snapshot_title') %></h2>
 <% if (profileNote) { %>
 <p class="note" style="margin:8px 0 14px">
  <strong>ℹ️ <%- t('portfolio_context') %>: </strong><%- profileNote %>
 </p>
 <% } %>
 <div class="card">
  <div class="grid3" style="margin-bottom:18px">
   <div class="statbox"><div class="n"><%- stats.totalAccounts %></div><div class="l"><%- t('stat_total_accounts') %></div></div>
   <div class="statbox"><div class="n"><%- formatINR(stats.totalOutstanding) %></div><div class="l"><%- t('stat_outstanding') %></div></div>
   <div class="statbox"><div class="n"><%- formatINR(stats.totalOverdue) %></div><div class="l"><%- t('stat_amount_overdue') %></div></div>
   <div class="statbox"><div class="n"><%- stats.utilizationPct %>%</div><div class="l"><%- t('stat_utilization') %></div></div>
   <div class="statbox"><div class="n"><%- stats.oldestVintage || '—' %></div><div class="l"><%- t('stat_oldest_vintage') %></div></div>
   <div class="statbox"><div class="n"><%- enquiryCounts.enquiries_12m != null ? enquiryCounts.enquiries_12m : '—' %></div><div class="l"><%- t('stat_enquiries_12m') %></div></div>
  </div>

  <table>
   <thead><tr><th><%- t('metric') %></th><th><%- t('value') %></th><th><%- t('read') %></th></tr></thead>
   <tbody>
    <tr><td><%- t('metric_total_sanctioned') %></td><td><%- formatINR(stats.totalSanctioned) %></td><td><%- t('metric_total_sanctioned_desc') %></td></tr>
    <tr>
     <td><%- t('metric_total_written_off') %></td>
     <td style="color:#dc3545;font-weight:700"><%- formatINR(stats.totalWrittenOff) %></td>
     <td><%- stats.totalWrittenOff > 0 ? accounts.filter(function(a){return (a.written_off_amount||0)>0}).map(function(a){return a.lender}).join(', ') : t('none') %></td>
    </tr>
     <tr><td><%- t('metric_secured_exposure') %></td>
      <% if (stats.hasActiveBalance) { %>
      <td><%- formatINR(stats.securedOutstanding) %></td><td><%- t('metric_secured_exposure_desc_active') %></td>
      <% } else { %>
      <td><%- formatINR(stats.securedSanctioned) %></td><td><%- t('metric_secured_exposure_desc_closed') %></td>
      <% } %>
     </tr>
     <tr><td><%- t('metric_unsecured_exposure') %></td>
      <% if (stats.hasActiveBalance) { %>
      <td><%- formatINR(stats.unsecuredOutstanding) %></td><td><%- t('metric_unsecured_exposure_desc_active') %></td>
      <% } else { %>
      <td><%- formatINR(stats.unsecuredSanctioned) %></td><td><%- t('metric_unsecured_exposure_desc_closed') %></td>
      <% } %>
     </tr>
    <tr><td><%- t('metric_active_accounts') %></td><td><%- stats.activeAccounts %></td><td><%- t('metric_active_accounts_desc') %></td></tr>
    <% if(data.foir_percent != null){ %>
    <tr><td><%- t('metric_foir') %></td><td><%- data.foir_percent %>%</td><td><%- data.foir_rating || '—' %></td></tr>
    <% } %>
    <% if(data.max_eligible_amount){ %>
    <tr><td><%- t('metric_max_eligible') %></td><td><%- formatINR(data.max_eligible_amount) %></td><td><%- t('metric_max_eligible_desc') %></td></tr>
    <% } %>
   </tbody>
  </table>

  <div class="grid2">
   <div>
    <h4 style="text-align:center"><%- chartUrls.portfolioMix && chartUrls.portfolioMix.isLifetimeView ? t('portfolio_mix_lifetime') : t('portfolio_mix') %> <span style="font-size:0.8rem; font-weight:normal; color:#666"><br><%- t('in_thousands') %></span></h4>
    <% if (chartUrls.portfolioMix) { %>
     <img class="chartimg" src="<%- chartUrls.portfolioMix.url %>" alt="<%- t('portfolio_mix') %>">
    <% } else { %>
     <div style="background:#faf9ff; border:1px solid #ece8fb; border-radius:8px; padding:30px; text-align:center; color:var(--muted); font-size:.9rem; min-height:180px; display:flex; align-items:center; justify-content:center;">
      <%- t('no_active_exposure') %>
     </div>
    <% } %>
   </div>
   <div>
    <h4 style="text-align:center"><%- t('risk_severity_dist') %></h4>
    <% if (chartUrls.riskSeverity) { %>
     <img class="chartimg" src="<%- chartUrls.riskSeverity %>" alt="<%- t('risk_severity_dist') %>">
    <% } else { %>
     <div style="background:#faf9ff; border:1px solid #ece8fb; border-radius:8px; padding:30px; text-align:center; color:var(--muted); font-size:.9rem; min-height:180px; display:flex; align-items:center; justify-content:center;">
      <%- t('no_significant_risks') %>
     </div>
    <% } %>
   </div>
  </div>
  <div class="grid2" style="margin-top:18px">
   <div>
    <h4 style="text-align:center"><%- t('accounts_by_type') %></h4>
    <% if (chartUrls.accountsByType) { %>
     <img class="chartimg" src="<%- chartUrls.accountsByType %>" alt="<%- t('accounts_by_type') %>">
    <% } else { %>
     <div style="background:#faf9ff; border:1px solid #ece8fb; border-radius:8px; padding:30px; text-align:center; color:var(--muted); font-size:.9rem; min-height:180px; display:flex; align-items:center; justify-content:center;">
      <%- t('no_accounts_classify') %>
     </div>
    <% } %>
   </div>
   <div>
    <h4 style="text-align:center"><%- t('accounts_by_lender') %></h4>
    <% if (chartUrls.accountsByLender) { %>
     <img class="chartimg" src="<%- chartUrls.accountsByLender %>" alt="<%- t('accounts_by_lender') %>">
    <% } else { %>
     <div style="background:#faf9ff; border:1px solid #ece8fb; border-radius:8px; padding:30px; text-align:center; color:var(--muted); font-size:.9rem; min-height:180px; display:flex; align-items:center; justify-content:center;">
      <%- t('no_accounts_group') %>
     </div>
    <% } %>
   </div>
  </div>
  <div style="margin-top:18px">
   <h4 style="text-align:center"><%- t('enquiry_activity') %></h4>
   <% if (chartUrls.enquiryTimeline) { %>
    <img class="chartimg" src="<%- chartUrls.enquiryTimeline %>" alt="<%- t('enquiry_activity') %>" style="max-height:280px; width:auto; display:block; margin:0 auto;">
   <% } else { %>
    <div style="background:#faf9ff; border:1px solid #ece8fb; border-radius:8px; padding:30px; text-align:center; color:var(--muted); font-size:.9rem; min-height:180px; display:flex; align-items:center; justify-content:center;">
     <%- t('no_enquiries') %>
    </div>
   <% } %>
  </div>
 </div>
</div>

<!-- ═══════════════════════ SECTION 02: Top Risk Factors ═══════════════════════ -->
<div class="container">
 <h2 class="section-title"><span class="section-no">02</span> <%- t('top_risk_factors_title') %></h2>
 <p class="lead"><%- t('top_risk_factors_lead') %></p>
 <div class="card">
  <% riskFactors.forEach(function(rf, i){ %>
  <div class="risk-item" style="border-left-color:<%- rf._color %><% if(isRTL){ %>;border-left:none;border-right:5px solid <%- rf._color %><% } %>">
   <div class="rk"><%- i + 1 %></div>
   <div>
    <span class="badge b-<%- rf.severity %>"><%- tSeverity(rf.severity) %></span>
    <div style="font-weight:700;margin:6px 0 4px"><%- rf.title %></div>
    <div style="color:#444;font-size:.9rem"><%- rf.explanation %></div>
   </div>
  </div>
  <% }); %>
  <% if(!riskFactors.length){ %><p style="color:var(--muted)"><%- t('no_significant_risks') %></p><% } %>
 </div>
</div>

<!-- ═══════════════════════ SECTION 03: Portfolio Analysis ═══════════════════════ -->
<div class="container">
 <h2 class="section-title"><span class="section-no">03</span> <%- t('portfolio_analysis_title') %></h2>
 <div class="card">
  <div style="overflow-x:auto">
   <table>
    <thead>
     <tr><th><%- t('lender') %></th><th><%- t('type') %></th><th><%- t('sanctioned') %></th><th><%- t('balance') %></th><th><%- t('util_pct') %></th><th><%- t('max_dpd') %></th><th><%- t('status') %></th><th><%- t('risk') %></th></tr>
    </thead>
    <tbody>
     <% accounts.forEach(function(acct){ %>
     <tr>
      <td><%- acct.lender %></td>
      <td><%- tAccountType(acct.account_type) %></td>
      <td><%- formatINR(acct.sanctioned_amount) %></td>
      <td><%- formatINR(acct.current_balance) %></td>
      <td><%- acct._utilPct %>%</td>
      <td><%- acct.max_dpd || 0 %></td>
      <td><%- tStatus(acct.status) %></td>
      <td><span class="badge b-<%- acct._severity %>"><%- tSeverity(acct._severity) %></span></td>
     </tr>
     <% }); %>
    </tbody>
   </table>
  </div>
  <div class="grid2" style="margin-top:18px">
   <div>
    <h4 style="text-align:center"><%- chartUrls.outstandingVsSanct && chartUrls.outstandingVsSanct.isLifetimeView ? t('outstanding_vs_sanctioned_lifetime') : t('outstanding_vs_sanctioned') %> <span style="font-size:0.8rem; font-weight:normal; color:#666"><br><%- t('in_thousands') %></span></h4>
    <% if (chartUrls.outstandingVsSanct) { %>
     <img class="chartimg" src="<%- chartUrls.outstandingVsSanct.url %>" alt="<%- t('outstanding_vs_sanctioned') %>">
    <% } else { %>
     <div style="background:#faf9ff; border:1px solid #ece8fb; border-radius:8px; padding:30px; text-align:center; color:var(--muted); font-size:.9rem; min-height:180px; display:flex; align-items:center; justify-content:center;">
      <%- t('no_active_outstanding') %>
     </div>
    <% } %>
   </div>
   <div>
    <h4 style="text-align:center"><%- t('risk_map') %></h4>
    <img class="chartimg" src="<%- chartUrls.riskMap %>" alt="<%- t('risk_map') %>">
   </div>
  </div>
 </div>
</div>

<!-- ═══════════════════════ SECTION 04: Detailed Account Breakdown ═══════════════════════ -->
<div class="container">
 <h2 class="section-title"><span class="section-no">04</span> <%- t('detailed_account_title') %></h2>
 <p class="lead"><%- t('detailed_account_lead') %></p>
 <div class="card">
  <div style="display:flex;gap:14px;flex-wrap:wrap;font-size:.8rem;margin:8px 0 16px">
   <span><b style="color:#28a745">■</b> <%- t('dpd_legend_on_time') %></span>
   <span><b style="color:#ffc107">■</b> <%- t('dpd_legend_1_29') %></span>
   <span><b style="color:#fd7e14">■</b> <%- t('dpd_legend_30_89') %></span>
   <span><b style="color:#dc3545">■</b> <%- t('dpd_legend_90_plus') %></span>
   <span><b style="color:#adb5bd">■</b> <%- t('dpd_legend_not_reported') %></span>
  </div>

  <% accounts.forEach(function(acct){ %>
  <div class="acct-card">
   <div class="acct-head">
    <div class="who"><%- acct.lender %> &nbsp;·&nbsp; <%- tAccountType(acct.account_type) %></div>
    <span class="badge b-<%- acct._severity %>"><%- tSeverity(acct._severity) %></span>
   </div>
   <div class="acct-body">
    <div class="gridkv">
     <div class="kv"><b><%- t('account_no') %></b><span><%- acct.masked_account_number || '—' %></span></div>
     <div class="kv"><b><%- t('ownership') %></b><span><%- tOwnership(acct.ownership) %></span></div>
     <div class="kv"><b><%- t('opened') %></b><span><%- acct.opened_date || '—' %></span></div>
     <div class="kv"><b><%- t('closed') %></b><span><%- acct.closed_date || t('active') %></span></div>
     <div class="kv"><b><%- t('sanctioned') %></b><span><%- formatINR(acct.sanctioned_amount) %></span></div>
     <div class="kv"><b><%- t('balance') %></b><span><%- formatINR(acct.current_balance) %></span></div>
     <div class="kv"><b><%- t('overdue') %></b><span><%- formatINR(acct.overdue_amount) %></span></div>
     <div class="kv"><b><%- t('max_dpd') %></b><span><%- t('n_days', {n: acct.max_dpd || 0}) %></span></div>
     <% if((acct.written_off_amount||0) > 0){ %>
     <div class="kv"><b><%- t('written_off') %></b><span style="color:#dc3545;font-weight:700"><%- formatINR(acct.written_off_amount) %></span></div>
     <% } %>
     <% if(acct.suit_filed){ %>
     <div class="kv"><b><%- t('suit_filed') %></b><span style="color:#dc3545;font-weight:700"><%- t('yes') %></span></div>
     <% } %>
     <% if(acct.emi_amount){ %>
     <div class="kv"><b><%- t('emi') %></b><span><%- formatINR(acct.emi_amount) %>/mo</span></div>
     <% } %>
    </div>

    <%# Health bar %>
    <div style="margin-top:14px">
     <b style="font-size:.85rem"><%- t('account_health', {score: acct._healthScore}) %></b>
     <div class="hbar">
      <span style="width:<%- acct._healthScore %>%;background:<%- acct._severityColor %>"></span>
     </div>
    </div>

    <%# Payment history grid %>
    <% if(acct.dpd_history && acct.dpd_history.length > 0){ %>
    <div style="margin-top:14px">
     <b style="font-size:.85rem"><%- t('payment_history') %></b>
     <div class="ph-grid">
      <% acct.dpd_history.forEach(function(h){ %>
      <div class="ph-cell" style="background:<%- dpdCodeToColor(h.value) %>">
       <small><%- tMonthLabel(h.month) %></small><%- h.value %>
      </div>
      <% }); %>
     </div>
    </div>
    <% } %>

    <%# DPD history bar chart — only for delinquent accounts %>
    <% if((acct.max_dpd||0) > 0 && chartUrls.dpdCharts[acct.masked_account_number]){ %>
    <h4 style="margin-top:16px"><%- t('dpd_history_chart') %></h4>
    <img class="chartimg" src="<%- chartUrls.dpdCharts[acct.masked_account_number] %>" alt="<%- t('dpd_history_chart') %> — <%- acct.lender %>">
    <% } %>
   </div>
  </div>
  <% }); %>
 </div>
</div>

<!-- ═══════════════════════ SECTION 05: Strategic Analysis ═══════════════════════ -->
<div class="container">
 <h2 class="section-title"><span class="section-no">05</span> <%- t('strategic_analysis_title') %></h2>
 <div class="card">
  <h4><%- t('health_heatmap') %></h4>
  <div style="overflow-x:auto">
   <table class="heat">
    <thead>
     <tr>
      <th style="background:var(--grad);color:#fff;text-align:<%- isRTL ? 'right' : 'left' %>"><%- t('account') %></th>
      <th style="background:var(--grad);color:#fff"><%- t('max_dpd') %></th>
      <th style="background:var(--grad);color:#fff"><%- t('health') %></th>
      <th style="background:var(--grad);color:#fff"><%- t('written_off') %></th>
      <th style="background:var(--grad);color:#fff"><%- t('overdue') %></th>
     </tr>
    </thead>
    <tbody>
     <% accounts.forEach(function(acct){ %>
     <tr>
      <td class="lbl"><%- acct.lender %> · <%- tAccountType(acct.account_type) %></td>
      <td style="background:<%- acct._severityColor %>"><%- acct.max_dpd || 0 %></td>
      <td style="background:<%- acct._severityColor %>"><%- acct._healthScore %></td>
      <td style="background:<%= (acct.written_off_amount||0)>0 ? '#dc3545' : '#28a745' %>"><%- (acct.written_off_amount||0) > 0 ? t('yes') : t('no') %></td>
      <td style="background:<%= (acct.overdue_amount||0)>0 ? '#dc3545' : '#28a745' %>"><%- (acct.overdue_amount||0) > 0 ? t('yes') : t('no') %></td>
     </tr>
     <% }); %>
    </tbody>
   </table>
  </div>

  <h4 style="margin-top:24px"><%- t('risk_concentration') %></h4>
  <p style="color:#444;line-height:1.7"><%- data.risk_concentration_paragraph || t('analysis_not_available') %></p>

  <%# Enquiries table (if any) %>
  <% if(enquiries && enquiries.length > 0){ %>
  <h4 style="margin-top:24px"><%- t('credit_enquiries', {n: enquiries.length}) %></h4>
  <div style="overflow-x:auto">
   <table class="enq-table">
    <thead><tr><th><%- t('member') %></th><th><%- t('date') %></th><th><%- t('purpose') %></th><th><%- t('amount') %></th></tr></thead>
    <tbody>
     <% enquiries.forEach(function(enq){ %>
     <tr>
      <td><%- enq.member || '—' %></td>
      <td><%- enq.date || '—' %></td>
      <td><%- tEnquiryPurpose(enq.purpose) %></td>
      <td><%- enq.amount ? formatINR(enq.amount) : '—' %></td>
     </tr>
     <% }); %>
    </tbody>
   </table>
  </div>
  <% } %>
 </div>
</div>

<!-- ═══════════════════════ SECTION 06: 90-Day Action Plan ═══════════════════════ -->
<div class="container">
 <h2 class="section-title"><span class="section-no">06</span> <%- t('action_plan_title') %></h2>
 <div class="card">
  <div class="grid3">
   <div class="issue c">
    <h4><%- t('month_1') %></h4>
    <p><%- data.action_month_1 || t('action_steps_unavailable') %></p>
   </div>
   <div class="issue m">
    <h4><%- t('month_2') %></h4>
    <p><%- data.action_month_2 || t('action_steps_unavailable') %></p>
   </div>
   <div class="issue h" style="border-left-color:#28a745;background:#eafaef<% if(isRTL){ %>;border-left:none;border-right-color:#28a745<% } %>">
    <h4><%- t('month_3') %></h4>
    <p><%- data.action_month_3 || t('action_steps_unavailable') %></p>
   </div>
  </div>

  <h4 style="margin-top:24px;text-align:center"><%- t('projected_score_trajectory') %></h4>
  <img class="chartimg" src="<%- chartUrls.projectedScore %>" alt="<%- t('projected_score_trajectory') %>" style="max-width:640px;margin:auto;display:block">

  <p class="note" style="margin-top:16px">
   <%- data.projection_assumptions || t('projection_assumptions_default') %>
  </p>

  <% if(data.recommendation){ %>
  <div style="background:var(--grad);color:#fff;border-radius:10px;padding:18px;margin-top:18px;text-align:center">
   <b style="font-size:1.05rem">📋 <%- t('overall_recommendation') %></b>
   <p style="margin:8px 0 0;opacity:.95"><%- data.recommendation %></p>
  </div>
  <% } %>
